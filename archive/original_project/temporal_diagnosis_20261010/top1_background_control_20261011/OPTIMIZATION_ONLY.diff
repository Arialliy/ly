+def background_top1pct_mean(pixel_losses: torch.Tensor) -> torch.Tensor:
+    """Nonempty 1-D unreduced negative losses; ties favor smaller flat indices."""
+    k = max(1, math.ceil(.01 * pixel_losses.numel()))
+    # topk determines only the value cutoff; it never chooses the gradient support.
+    cutoff = pixel_losses.topk(k, sorted=False).values.min()
+    above = pixel_losses > cutoff
+    tied = pixel_losses == cutoff
+    remaining = k - above.sum()
+    tie_order = tied.to(torch.int32).cumsum(dim=0)
+    chosen = above | (tied & (tie_order <= remaining))
+    return pixel_losses[chosen].mean()
+
