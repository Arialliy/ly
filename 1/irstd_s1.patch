+        clip, f = fixture_clip()
+        f = f.detach().requires_grad_()
+        grid = make_velocity_grid([0], [0], device=DEVICE)
+        q = torch.tensor([[2, 3], [5, 4]], device=DEVICE)
+        out = sample_clip_features(f, clip, q, grid)
+        keep = list(range(8)) + list(range(9, 17))
