+        rows = torch.arange(w, device=DEVICE)
+        f[rows, 0, 0, 0, rows] = 1
+        valid[rows, 0, 0, 0, rows] = True
+        f.requires_grad_()
+        q = torch.stack([rows, torch.zeros_like(rows)], -1).float()[:, None]
+        out = sample_context(f, torch.zeros(w, 1, device=DEVICE), q,
