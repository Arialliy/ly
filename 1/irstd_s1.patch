+    def test_13_feature_finite_difference_gradcheck(self):
+        # CPU double is intentional; CUDA atomic addition is not bitwise deterministic.
+        f = torch.rand(1, 2, 1, 5, 6, dtype=torch.float64, requires_grad=True)
